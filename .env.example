# Frontend origins autorizzate per backend e agent
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Modelli
LLAMA_MODEL=llama3.1:8b
EMBED_MODEL=all-MiniLM-L6-v2
TOP_K=10
AGENT_TOP_K=8
TRANSLATE_QUERY=false

# Sicurezza backend
ADMIN_TOKEN=change-me
MAX_UPLOAD_MB=50
MIN_RETRIEVAL_SCORE=0.30
RETRIEVAL_OVERSAMPLE=3

# Home Assistant Agent
HA_HOST=http://homeassistant:8123
HA_TOKEN=
HA_CONFIG_HOST_PATH=/path/to/homeassistant/config
ENABLE_WEB_SEARCH=false
ALLOW_HA_ACTIONS=false
ACTION_CONFIRM_TOKEN=change-me
MAX_CONFIG_CHARS=7000
MAX_EXTRA_CHARS=4000